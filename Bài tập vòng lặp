fun main() {
    // Bài 1: In các số từ 1 đến 10
    println("Bai 1: In cac so tu 1 den 10:")
    for (i in 1..10) {
        print("$i ")
    }
    println("\n")

    // Bài 2: Tính tổng từ 1 đến 100
    var sum = 0
    for (i in 1..100) {
        sum += i
    }
    println("Bai 2: Tong tu 1 den 100 la: $sum\n")

    // Bài 3: In các số chẵn từ 1 đến 20
    println("Bai 3: In cac so chan tu 1 den 20:")
    for (i in 2..20 step 2) {
        print("$i ")
    }
    println()
}
